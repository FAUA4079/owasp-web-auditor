{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "source_hash",
    "status",
    "reviews"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "pending",
        "partial",
        "complete",
        "not_applicable"
      ]
    },
    "reviews": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/review"
      }
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment",
        "explanation",
        "uncertainty",
        "evidence_refs",
        "suggested_verification"
      ],
      "properties": {
        "assessment": {
          "enum": [
            "consistent_with_observation",
            "possible_false_positive",
            "insufficient_context",
            "needs_human_review"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2200,
          "pattern": "^[^\\u0980-\\u09ff]*$"
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2200,
          "pattern": "^[^\\u0980-\\u09ff]*$"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          }
        },
        "suggested_verification": {
          "enum": [
            "none",
            "review_error_context",
            "review_reflection_context",
            "review_input_handling",
            "review_access_policy",
            "review_query_parameterization",
            "review_session_revocation"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "rule_id",
        "scanner_status",
        "provider",
        "model",
        "created_at",
        "review_required",
        "payload"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "rule_id": {
          "enum": [
            "CHK05",
            "CHK07",
            "CHK08",
            "CHK09",
            "CHK10",
            "CHK11",
            "CHK12"
          ]
        },
        "scanner_status": {
          "enum": [
            "Confirmed",
            "Potential",
            "Inconclusive",
            "No Issue Observed"
          ]
        },
        "provider": {
          "enum": [
            "ollama",
            "openai-compatible"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_required": {
          "const": true
        },
        "payload": {
          "$ref": "#/$defs/payload"
        }
      }
    }
  }
}
