{
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "test_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "captured_at": {
      "type": "string"
    },
    "content_hash": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "scope": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "scope",
        "value"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "content_hash"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
